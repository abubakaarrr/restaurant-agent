# Development template. Never commit a populated .env.

# Database
# Use 127.0.0.1, not localhost, on Windows (IPv6/WSL relay breaks Docker ports).
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/restaurant_agent

# Legacy LangGraph rollback adapter
OPENAI_API_KEY=sk-proj-xxxxxxxx
LLM_MODEL=gpt-5.6-terra
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=160
LLM_REASONING_EFFORT=none

# Retell managed flow and rollback WebSocket
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_CHAT_AGENT_ID=
RETELL_PUBLIC_KEY=
RETELL_PHONE_NUMBER=
STAFF_TRANSFER_NUMBER=
RETELL_COUNTRY_CODE=US
RETELL_AREA_CODE=
RETELL_NUMBER_PROVIDER=twilio
RETELL_AGENT_VERSION=latest_published
RETELL_FALLBACK_NUMBER=
VOICE_TOOL_SECRET=replace-with-random-tool-secret
RETELL_WS_TOKEN=replace-with-random-websocket-token
VOICE_LIVE_WRITES_ENABLED=false
ENABLE_LEGACY_RETELL_CUSTOM_LLM=true
ENABLE_LEGACY_VAPI=false
ENABLE_PUBLIC_WEB_CALLS=false

# Optional Vapi rollback
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_SERVER_SECRET=

# LangSmith (optional; review PII settings before enabling)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxx
LANGCHAIN_PROJECT=restaurant-agent-pilot

# Restaurant configuration
RESTAURANT_NAME=The Lamplighter Public House
RESTAURANT_TIMEZONE=America/Vancouver
AI_AGENT_NAME=Clough
SUPPORTED_LOCALES=en-US
CALL_DATA_RETENTION_DAYS=30
CALL_RECORDING_ENABLED=false
STORE_CALL_TRANSCRIPTS=false

# Website widget (public credentials only)
WIDGET_ENABLED=false
WIDGET_MODE=hybrid
WIDGET_ALLOWED_DOMAINS=http://localhost:8000
WIDGET_TITLE=Talk to our restaurant host
WIDGET_LOGO_URL=
WIDGET_COLOR=
WIDGET_FAB_TEXT=How can we help?
CALLBACK_COUNTRIES=US,CA
CALLBACK_TERMS_URL=
RECAPTCHA_SITE_KEY=

# Application security
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

LOGIN_USERNAME=admin
LOGIN_PASSWORD=changeme
SESSION_SECRET=replace-with-a-long-random-string
DASHBOARD_API_KEY=
