# Production template only. Never place real credentials in this file.
# Generate secrets with a password manager or:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Database
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/restaurant_agent

# LLM used only by the feature-flagged legacy LangGraph rollback adapter
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
LLM_MODEL=gpt-5.6-terra
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=160
LLM_REASONING_EFFORT=none

# Retell managed voice
RETELL_API_KEY=REPLACE_WITH_RETELL_WEBHOOK_ENABLED_KEY
RETELL_AGENT_ID=REPLACE_WITH_RETELL_VOICE_AGENT_ID
RETELL_CHAT_AGENT_ID=
RETELL_PUBLIC_KEY=REPLACE_WITH_DOMAIN_RESTRICTED_PUBLIC_KEY
RETELL_PHONE_NUMBER=
STAFF_TRANSFER_NUMBER=
RETELL_COUNTRY_CODE=US
RETELL_AREA_CODE=
RETELL_NUMBER_PROVIDER=twilio
RETELL_AGENT_VERSION=latest_published
RETELL_FALLBACK_NUMBER=
VOICE_TOOL_SECRET=REPLACE_WITH_48_PLUS_RANDOM_CHARACTERS
RETELL_WS_TOKEN=REPLACE_WITH_48_PLUS_RANDOM_CHARACTERS

# Rollout flags: keep writes off until migrations and acceptance tests pass
VOICE_LIVE_WRITES_ENABLED=false
ENABLE_LEGACY_RETELL_CUSTOM_LLM=false
ENABLE_LEGACY_VAPI=false
ENABLE_PUBLIC_WEB_CALLS=false

# Vapi rollback only
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_SERVER_SECRET=

# Restaurant identity and caller policy
AI_AGENT_NAME=Avery
SUPPORTED_LOCALES=en-US
CALL_DATA_RETENTION_DAYS=30
CALL_RECORDING_ENABLED=false
STORE_CALL_TRANSCRIPTS=false

# Client website widget
WIDGET_ENABLED=false
WIDGET_MODE=hybrid
WIDGET_ALLOWED_DOMAINS=https://www.example-restaurant.com
WIDGET_TITLE=Talk to our restaurant host
WIDGET_LOGO_URL=
WIDGET_COLOR=
WIDGET_FAB_TEXT=How can we help?
CALLBACK_COUNTRIES=US,CA
CALLBACK_TERMS_URL=https://www.example-restaurant.com/privacy
RECAPTCHA_SITE_KEY=

# Dashboard and application security
APP_ENV=production
ALLOWED_ORIGINS=https://agent.example.com
LOGIN_USERNAME=REPLACE_WITH_NON_DEFAULT_USERNAME
LOGIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SESSION_SECRET=REPLACE_WITH_48_PLUS_RANDOM_CHARACTERS
DASHBOARD_API_KEY=REPLACE_WITH_48_PLUS_RANDOM_CHARACTERS

# Optional tracing. Confirm the provider's PII settings before enabling.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=restaurant-agent-prod

# Offline Chatterbox studio only; not part of the production call route
CHATTERBOX_API_URL=http://tts:8080
CHATTERBOX_API_KEY=REPLACE_WITH_RANDOM_INTERNAL_SECRET
VAPI_VOICE_KEY=
